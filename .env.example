# Added automatically when you connect a Neon database in Vercel → Storage
DATABASE_URL=

# Your Anthropic API key (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Random 32+ characters. Signs logins and derives the read-only database passwords.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Passcodes people type to sign in. The passcode decides the role. Use 8+ characters.
STAFF_PASSCODE=
MANAGER_PASSCODE=
# ADMIN_PASSCODE=

# Optional
RESTAURANT_NAME=Our Kitchen
APP_TIMEZONE=America/Chicago
# ANTHROPIC_MODEL=claude-sonnet-5-5
